# ===============================
# OS / Editor files
# ===============================
.DS_Store
Thumbs.db

.vscode/
.idea/
*.swp
*.swo

# ===============================
# Environment / config files
# ===============================
.env
.env.*
config.php
config/*.php

# ===============================
# Logs
# ===============================
*.log
logs/
error_log

# ===============================
# PHP dependencies (if using Composer)
# ===============================
/vendor/
composer.phar
composer.lock

# PHP CS Fixer (anywhere)
.php-cs-fixer.php
.php-cs-fixer.dist.php
.php-cs-fixer.cache
**/.php-cs-fixer*


# ===============================
# Node / Frontend tools (if ever used)
# ===============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===============================
# Build / cache files
# ===============================
.cache/
.tmp/
dist/
build/

# ===============================
# Uploads & user-generated content
# ===============================
uploads/
public/uploads/

# ===============================
# Backup files
# ===============================
*.bak
*.backup
*.old

# ===============================
# Database dumps
# ===============================
*.sql
*.sqlite
*.db

# ===============================
# Sensitive keys
# ===============================
*.pem
*.key
